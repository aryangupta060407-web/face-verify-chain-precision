# Required for Google Lens/Yandex reverse-image search
SERPAPI_KEY=your_serpapi_key_here

# Optional official dedicated face-search provider adapter.
# Must be an authorized endpoint that returns JSON with a results/matches/images array.
FACE_SEARCH_PROVIDER_URL=
FACE_SEARCH_API_KEY=

# Optional OpenAI-compatible evidence normalization layer.
# The model never overrides local ArcFace verification.
OPENAI_API_KEY=
OPENAI_EVIDENCE_MODEL=gpt-5-mini
OPENAI_WEB_SEARCH_MODEL=gpt-5.5

# Local Ganache JSON-RPC
WEB3_PROVIDER_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=
DEPLOYER_PRIVATE_KEY=your_local_ganache_private_key_here
